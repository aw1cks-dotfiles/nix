{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: 'pr',
    // Renovate must observe green CI itself before merging.
    platformAutomerge: false,
    extends: [
      'schedule:weekly',
    ],
  },
  nix: {
    enabled: true,
  },
}
