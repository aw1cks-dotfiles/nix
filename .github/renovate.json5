{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  lockFileMaintenance: {
    enabled: true,
    // Skill content changes wait for a maintainer review before host builds.
    automerge: true,
    automergeType: 'pr',
    platformAutomerge: false,
    extends: [
      'schedule:weekly',
    ],
  },
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['nix'],
      matchPackageNames: [
        'https://github.com/intel/intel-performance-skills',
        'https://github.com/mohitmishra786/low-level-dev-skills',
        'https://github.com/rewrite-rs/skills',
        'https://github.com/trailofbits/skills',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      prBodyNotes: [
        'Review the skill-input-review diff comment, then approve this PR at its current head. A new push requires fresh approval.',
      ],
    },
  ],
}
