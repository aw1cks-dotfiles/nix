{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  lockFileMaintenance: {
    enabled: true,
    // The host-check job rejects unreviewed skill contents before building.
    automerge: true,
    automergeType: 'pr',
    platformAutomerge: false,
    extends: [
      'schedule:weekly',
    ],
  },
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['nix'],
      matchPackageNames: [
        'https://github.com/intel/intel-performance-skills',
        'https://github.com/mohitmishra786/low-level-dev-skills',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      prBodyNotes: [
        'Review the upstream skill diff and update .github/reviewed-skill-inputs.json only after approving the new contents.',
      ],
    },
  ],
}
