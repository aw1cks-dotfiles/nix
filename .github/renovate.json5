{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  lockFileMaintenance: {
    enabled: true,
    // Nix maintenance updates every input, including agent instructions.
    // Per-package automerge rules cannot protect this mixed update.
    automerge: false,
    extends: [
      'schedule:weekly',
    ],
  },
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['nix'],
      matchPackageNames: [
        'https://github.com/intel/intel-performance-skills',
        'https://github.com/mohitmishra786/low-level-dev-skills',
      ],
      automerge: false,
      prBodyNotes: [
        'Review the upstream skill diff: CI checks assembly and known regressions, not instruction safety.',
      ],
    },
  ],
}
